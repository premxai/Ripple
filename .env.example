# Copy to .env (gitignored). Values here override your system environment.

# Neon AI Gateway: all agent models (residents + panel)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# OpenAI direct: transcripts (whisper-1) and panel voices (gpt-4o-mini-tts)
OPENAI_API_KEY=

# Telem: Trend Scout web search (app.telem.ai, key starts with tlm_)
TELEM_API_KEY=

# 1 = rule-based residents, no model calls (free; for UI work and rehearsals)
RIPPLE_MOCK=0
RIPPLE_CALL_TIMEOUT=12

# Optional: refresh the Bruin pipeline after each round, e.g.
# RIPPLE_BRUIN_CMD=wsl -d Ubuntu -- bash -lc "cd /mnt/c/path/to/ripple && bruin run analytics"
RIPPLE_BRUIN_CMD=
